{
  "name": "dsh-workspace-capabilities",
  "version": "0.1.1",
  "description": "Per-workspace control over which skills the model auto-loads and which MCP servers stay hidden in DeepSeek Harness",
  "author": "HosheaLi",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "mcp",
    "workspace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HosheaLi/dsh-workspace-capabilities.git"
  },
  "homepage": "https://github.com/HosheaLi/dsh-workspace-capabilities#readme",
  "bugs": {
    "url": "https://github.com/HosheaLi/dsh-workspace-capabilities/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test test/config.test.js test/cwd.test.js test/rpc.test.js test/client.test.js test/render.test.js test/catalog.test.js test/policy.test.js test/mcp.test.js test/skills.test.js test/prompt.test.js test/preset.test.js test/index.test.js",
    "test:integration": "node --test test/integration.test.js test/integration-catalog.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-functions=90 --test-coverage-branches=80 --test-coverage-exclude=\"test/**\" \"test/**/*.test.js\"",
    "build:index": "node tools/build-market-index.mjs",
    "check:index": "node tools/check-market-index.mjs",
    "prepublishOnly": "npm test"
  }
}
