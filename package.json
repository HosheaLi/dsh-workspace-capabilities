{
  "name": "dsh-workspace-scope",
  "version": "0.1.0",
  "description": "按工作区（项目目录）决定技能是否进入模型目录、并屏蔽无关 MCP 服务器工具的 DSH 插件",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test test/config.test.js test/rpc.test.js test/client.test.js test/render.test.js test/catalog.test.js test/policy.test.js test/mcp.test.js test/skills.test.js test/index.test.js",
    "test:integration": "node --test test/integration.test.js"
  },
  "license": "MIT",
  "private": true
}
